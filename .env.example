# API Keys — copy this file to .env and fill in your real values.
# Never commit .env to version control.

ANTHROPIC_API_KEY=your_anthropic_api_key_here
APOLLO_API_KEY=your_apollo_api_key_here
APIFY_API_TOKEN=your_apify_api_token_here
ZEROBOUNCE_API_KEY=your_zerobounce_api_key_here

# Apify actor slug — e.g. "apify/linkedin-profile-scraper"
# or a custom actor ID from your Apify console.
APIFY_ACTOR_ID=REPLACE_WITH_YOUR_ACTOR_ID

# Bright Data Dataset API — used for Stage 4 LinkedIn cross-verification
# (current employer/title check). Costs money per profile lookup; results
# are cached for 30 days in cache/linkedin_cache.db to limit repeat cost.
LINKEDIN_API_KEY=your_brightdata_api_key_here
LINKEDIN_API_URL=https://api.brightdata.com/datasets/v3/scrape?dataset_id=REPLACE_WITH_YOUR_DATASET_ID&notify=false&include_errors=true

# Email verification provider: "custom" (free DNS/SMTP check) or "zerobounce"
EMAIL_VERIFIER_PROVIDER=custom
