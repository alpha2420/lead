# API Keys — copy this file to .env and fill in your real values.
# Never commit .env to version control.

GEMINI_API_KEY=your_gemini_api_key_here
APIFY_API_TOKEN=your_apify_api_token_here
ZEROBOUNCE_API_KEY=your_zerobounce_api_key_here

# Apify actor — this pipeline's sole lead-sourcing platform.
APIFY_ACTOR_ID=code_crafter/leads-finder

# Bright Data Dataset API — used for Stage 4 LinkedIn cross-verification
# (current employer/title check). Costs money per profile lookup; results
# are cached for 30 days in cache/linkedin_cache.db to limit repeat cost.
LINKEDIN_API_KEY=your_brightdata_api_key_here
LINKEDIN_API_URL=https://api.brightdata.com/datasets/v3/scrape?dataset_id=REPLACE_WITH_YOUR_DATASET_ID&notify=false&include_errors=true

# Email verification provider — the UI's Email Sender field always uses
# "gmail_bounce" (sends a real email from GMAIL_SENDER_ADDRESS to each lead
# and watches for a real bounce — see pipeline/scoring.py's
# verify_emails_via_gmail_bounce() docstring for the tradeoffs). "custom"
# (free DNS/SMTP probe, no real emails sent) and "zerobounce" (paid API)
# still work if passed directly to the API, just aren't UI-selectable.
EMAIL_VERIFIER_PROVIDER=gmail_bounce

# GMAIL_APP_PASSWORD must be a 16-character Gmail App Password
# (myaccount.google.com/apppasswords), not your normal Gmail login password.
GMAIL_SENDER_ADDRESS=your_gmail_address_here@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password_here
